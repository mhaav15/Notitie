<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notepad_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/notepad_paper"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/notepad_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notepad_widget_name"
        android:textColor="@color/paper_hint"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notepad_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="top|start"
        android:lineSpacingExtra="4dp"
        android:text="@string/notepad_hint"
        android:textColor="@color/paper_text"
        android:textSize="17sp" />
</LinearLayout>
